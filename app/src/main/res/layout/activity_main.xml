<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/buttonMudaCor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/imageCirculo"
        android:layout_width="49dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@+id/buttonMudaCor"
        app:layout_constraintBottom_toBottomOf="@+id/buttonMudaCor"
        app:layout_constraintStart_toEndOf="@+id/buttonMudaCor"
        android:layout_marginStart="8dp"
        app:srcCompat="?android:attr/listChoiceIndicatorSingle" />

    <ImageButton
        android:id="@+id/imageTraco"
        android:layout_width="49dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@+id/imageCirculo"
        app:layout_constraintBottom_toBottomOf="@+id/imageCirculo"
        app:layout_constraintStart_toEndOf="@+id/imageCirculo"
        android:layout_marginStart="8dp"
        app:srcCompat="@drawable/dedinho" />

    <com.example.myapplication.SimplePaint
        android:id="@+id/simplePaint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/buttonMudaCor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/imageQuadrado"
        android:layout_width="49dp"
        android:layout_height="52dp"
        app:srcCompat="?android:attr/listChoiceIndicatorMultiple"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@+id/imageTraco"
        app:layout_constraintBottom_toBottomOf="@+id/imageTraco"
        app:layout_constraintStart_toEndOf="@+id/imageTraco"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/imageLinha"
        android:layout_width="49dp"
        android:layout_height="52dp"
        app:srcCompat="@drawable/traco"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@+id/imageQuadrado"
        app:layout_constraintBottom_toBottomOf="@+id/imageQuadrado"
        app:layout_constraintStart_toEndOf="@+id/imageQuadrado"
        android:layout_marginStart="8dp" />



</androidx.constraintlayout.widget.ConstraintLayout>