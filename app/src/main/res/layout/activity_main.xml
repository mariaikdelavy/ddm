<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.github.com/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SimplePaint">


    <com.example.myapplication.SimplePaint
        android:id="@+id/simplePaint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonMudaCor" />

    <Button
        android:id="@+id/buttonMudaCor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Color"
        tools2:layout_editor_absoluteX="19dp"
        tools2:layout_editor_absoluteY="15dp"
        tools2:ignore="MissingConstraints" />

    <ImageButton
        android:id="@+id/imageCirculo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/buttonMudaCor"
        app:srcCompat="?android:attr/listChoiceIndicatorSingle"
        tools2:layout_editor_absoluteX="107dp" />

    <ImageButton
        android:id="@+id/imageTraco"
        android:layout_width="49dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/imageCirculo"
        app:layout_constraintTop_toTopOf="@+id/imageCirculo"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/dedinho"
        tools2:layout_editor_absoluteX="163dp" />


</androidx.constraintlayout.widget.ConstraintLayout>